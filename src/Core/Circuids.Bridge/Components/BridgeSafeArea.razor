@namespace Circuids.Bridge
@inject IBridgeSafeArea SafeAreaService
@implements IDisposable

@ChildContent?.Invoke(SafeAreaService.SafeArea)

@code {
    [Parameter] public RenderFragment<SafeAreaInsets>? ChildContent { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            SafeAreaService.SafeAreaChanged += OnSafeAreaChanged;
            StateHasChanged();
        }
    }

    private void OnSafeAreaChanged(object? sender, SafeAreaInsets e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose() => SafeAreaService.SafeAreaChanged -= OnSafeAreaChanged;
}
