@namespace Circuids.Bridge
@inject IBridgeConnectivity BridgeConnection
@implements IDisposable

@ChildContent?.Invoke(isOnline)

@if (isOnline)
{
    @Online
}
else
{
    @Offline
}

@code {
    [Parameter] public RenderFragment? Online { get; set; }
    [Parameter] public RenderFragment? Offline { get; set; }
    [Parameter] public RenderFragment<bool>? ChildContent { get; set; }

    [Parameter] public bool IsConnected { get; set; }
    [Parameter] public EventCallback<bool> IsConnectedChanged { get; set; }

    private bool isOnline = true;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            isOnline = BridgeConnection.IsConnected;
            _ = IsConnectedChanged.InvokeAsync(isOnline);
            BridgeConnection.ConnectionChanged += OnConnectionChanged;
            StateHasChanged();
        }
    }

    private void OnConnectionChanged(object? sender, bool e)
    {
        if (isOnline == e) return;

        isOnline = e;
        InvokeAsync(async () =>
        {
            await IsConnectedChanged.InvokeAsync(e);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        BridgeConnection.ConnectionChanged -= OnConnectionChanged;
    }
}
