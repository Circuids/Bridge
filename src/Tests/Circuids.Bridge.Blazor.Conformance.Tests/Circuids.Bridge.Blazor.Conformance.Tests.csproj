<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <RootNamespace>Circuids.Bridge.Blazor.Conformance.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.6" PrivateAssets="all" />
    <PackageReference Include="Circuids.Pulse" Version="0.1.1-experimental" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Integrations\Circuids.Bridge.Blazor\Circuids.Bridge.Blazor.csproj" />
    <ProjectReference Include="..\Circuids.Bridge.TestSupport\Circuids.Bridge.TestSupport.csproj" />
  </ItemGroup>

</Project>